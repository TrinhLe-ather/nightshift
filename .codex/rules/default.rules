prefix_rule(pattern=["/bin/zsh", "-lc", "find _bmad-output -maxdepth 5 -iname '*epic*.md' -print 2>/dev/null || true"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "find _bmad-output -maxdepth 5 -iname '*ux*.md' -print 2>/dev/null || true"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "find _bmad-output -maxdepth 5 -iname '*research*.md' -print 2>/dev/null || true"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "find . -maxdepth 6 -iname 'project-context.md' -print 2>/dev/null || true"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "find . -maxdepth 4 \\( -iname 'prd.md' -o -iname '*prd*.md' -o -iname 'spec.md' -o -iname '*spec*.md' \\) -print 2>/dev/null | head -n 50"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "date -u +\"%Y-%m-%dT%H:%M:%SZ\""], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "ls -la @_bmad/bmm/agents || true\nls -la _bmad/bmm/agents || true\nrg -n \"^#|^<agent\" -S \"sm\\.md\" -g\"sm.md\" . || true"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "ls -la _bmad/core/tasks | sed -n '1,200p'\nls -la _bmad/core/tasks/validate-workflow.xml || true\nsed -n '1,220p' _bmad/core/tasks/validate-workflow.xml 2>/dev/null || true"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "ls -la _bmad-output 2>/dev/null || true\nfind _bmad-output -maxdepth 3 -type f -name \"*.md\" | head"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "ls -la _bmad-output | sed -n '1,200p'\nls -la _bmad-output/implementation-artifacts | sed -n '1,200p'\nls -la _bmad-output/ux*.md _bmad-output/ux.md 2>/dev/null || true"], decision="allow")
