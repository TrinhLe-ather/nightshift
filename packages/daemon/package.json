{
  "name": "@nightshift/daemon",
  "version": "0.2.2",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "nightshift": "src/index.ts"
  },
  "scripts": {
    "bun:env": "bun --env-file ../../.env.local",
    "dev": "bun bun:env . start -i",
    "cli": "bun bun:env .",
    "build": "bun ./scripts/build.ts",
    "lint": "oxlint --fix src/",
    "format": "oxfmt src/",
    "typecheck": "tsgo --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@anthropic-ai/claude-code": "^2.0.76",
    "@base-ui/react": "^1.0.0",
    "@git-diff-view/core": "^0.0.35",
    "@git-diff-view/file": "^0.0.35",
    "@git-diff-view/react": "^0.0.35",
    "@hugeicons/core-free-icons": "^3.1.0",
    "@hugeicons/react": "^1.1.4",
    "@nightshift/shared": "workspace:*",
    "@orpc/client": "catalog:orpc",
    "@orpc/experimental-publisher": "^1.13.1",
    "@orpc/openapi": "catalog:orpc",
    "@orpc/server": "catalog:orpc",
    "@orpc/zod": "catalog:orpc",
    "@tanstack/react-query": "^5.90.12",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "catalog:db",
    "drizzle-zod": "^0.8.3",
    "execa": "^9.6.1",
    "ghostty-web": "^0.4.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.69.0",
    "react-router-dom": "^7.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.8.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "catalog:db"
  }
}