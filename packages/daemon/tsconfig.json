{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components": [
        "./src/web/components/index.ts"
      ],
      "@/components/*": [
        "./src/web/components/*"
      ],
      "@/hooks/*": [
        "./src/web/hooks/*"
      ],
      "@/lib/*": [
        "./src/web/lib/*"
      ],
      "@/utils": [
        "./src/web/lib/utils"
      ],
    }
  },
  "include": [
    "src/**/*"
  ],
}