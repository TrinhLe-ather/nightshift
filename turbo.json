{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalPassThroughEnv": [
		"NODE_ENV",
		"CI",
		"npm_lifecycle_event"
	],
	"tasks": {
		"build": {
			"dependsOn": [
				"^build"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*"
			],
			"outputs": [
				"dist/**"
			]
		},
		"lint": {
			"dependsOn": [
				"^lint"
			]
		},
		"format": {
			"dependsOn": [
				"^format"
			]
		},
		"typecheck": {
			"dependsOn": [
				"^typecheck"
			]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}