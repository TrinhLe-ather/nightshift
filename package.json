{
  "name": "nightshift",
  "private": true,
  "repository": "https://github.com/sipherxyz/nightshift",
  "scripts": {
    "dev": "turbo dev",
    "format": "turbo format",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "build": "turbo build",
    "admin": "bun --filter @nightshift/admin",
    "backend": "bun --filter @nightshift/backend",
    "daemon": "bun --filter @nightshift/daemon",
    "shared": "bun --filter @nightshift/shared"
  },
  "devDependencies": {
    "@dotenv-run/cli": "^1.3.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "1.3.5",
    "@typescript/native-preview": "^7.0.0-dev.20251223.1",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.35.0",
    "oxlint-tsgolint": "^0.10.0",
    "turbo": "^2.7.2",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "typescript": "5.9.3",
      "zod": "4.2.1"
    },
    "catalogs": {
      "db": {
        "drizzle-kit": "0.31.8",
        "drizzle-orm": "0.45.1",
        "drizzle-zod": "^0.6.0"
      },
      "orpc": {
        "@orpc/client": "^1.13.0",
        "@orpc/openapi": "^1.13.0",
        "@orpc/server": "^1.13.0",
        "@orpc/zod": "^1.13.0"
      }
    }
  }
}